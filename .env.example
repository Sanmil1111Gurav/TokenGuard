# ==============================================================================
# TokenGuard Configuration
# ==============================================================================

# [REQUIRED] OpenAI API Key for generating code embeddings
# Used by text-embedding-3-small to index and semantically search codebase files.
OPENAI_API_KEY=your_openai_api_key_here

# [OPTIONAL] Embedding Model (default: text-embedding-3-small)
# Options: text-embedding-3-small, text-embedding-3-large
EMBEDDING_MODEL=text-embedding-3-small

# [OPTIONAL] ChromaDB Vector Database Persistence Directory
CHROMA_PERSIST_DIR=./chroma_db

# [OPTIONAL] Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==============================================================================
# Context & Token Budget Settings
# ==============================================================================

# Maximum input token cap for compressed prompts (default: 4000)
MAX_INPUT_TOKENS=4000

# Expected LLM completion token budget (default: 1024)
MAX_OUTPUT_TOKENS=1024

# Hard limit for Tier 4 (frozen/contextual background files) tokens (default: 600)
MAX_TIER4_TOKENS=600

# ==============================================================================
# Session & Ledger Settings
# ==============================================================================

# Directory where session states and snapshots are saved
SESSION_DIR=sessions

# Number of days before temporary session memory expires
SESSION_EXPIRY_DAYS=30

# Number of queries or edits before an automated snapshot is taken
SNAPSHOT_TRIGGER_COUNT=10
